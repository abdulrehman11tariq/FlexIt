{
  "manifest_version": 3,
  "name": "Course Feedback Fast",
  "short_name": "Feedback Fast",
  "version": "1.0.0",
  "description": "Fast, privacy-first automation for repetitive university course-feedback forms.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Course Feedback Fast",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}